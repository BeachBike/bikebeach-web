# Backend base URL. Leave UNSET in dev — Vite's proxy (vite.config.ts) sends
# `/api/*` to the local NestJS on :3000.
#
# In Vercel, set per environment:
#   Production env  → https://bikebeach-api-production.up.railway.app
#   Preview env     → https://bikebeach-api-dev.up.railway.app  (or whatever
#                     the dev Railway service URL is)
#
# Anything you set here is inlined at BUILD time, not at runtime, so you must
# redeploy after changing it.
VITE_API_BASE_URL=
